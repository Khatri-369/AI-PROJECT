# ==============================================================================
# STUDYAGENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND VARIABLES (Vite / React)
# Safe to expose to the browser.
# DO NOT place SUPABASE_SERVICE_ROLE_KEY here!
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_AGENT_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# BACKEND SERVER-ONLY VARIABLES (Node / Express)
# NEVER commit or expose to client-side bundles!
# ------------------------------------------------------------------------------
PORT=5000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI / LLM Configuration
GEMINI_API_KEY=AIzaSy...
# Or if using OpenAI:
OPENAI_API_KEY=sk-...

# Vector Embedding Configuration
# Default: 768 (Matches Google Gemini text-embedding-004 & OpenAI text-embedding-3-small with dimensions=768)
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
